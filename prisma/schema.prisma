// Prisma schema for the AI-Powered Academic Workflow Platform (Phase 1:
// School Setup, Curriculum Database, AI Lesson Planning).
// See: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Org / school setup
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears AcademicYear[]
  grades        Grade[]
  subjects      Subject[]
  users         User[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "2082/83 B.S."
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  academicPlans      AcademicPlan[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Grade {
  id       String @id @default(cuid())
  schoolId String
  name     String // e.g. "Grade 5"
  order    Int

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  teacherAssignments TeacherAssignment[]
  academicPlans      AcademicPlan[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id            String  @id @default(cuid())
  gradeId       String
  name          String // e.g. "A"
  classTeacherId String?

  grade        Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classTeacher User?  @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  teacherAssignments TeacherAssignment[]
  academicPlans      AcademicPlan[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  name     String // e.g. "Mathematics"
  code     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherAssignments TeacherAssignment[]
  academicPlans      AcademicPlan[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum UserRole {
  SCHOOL_ADMIN
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classTeacherOf     Section[]            @relation("ClassTeacher")
  teacherAssignments TeacherAssignment[]
  academicPlans      AcademicPlan[]

  @@index([schoolId])
}

model TeacherAssignment {
  id             String @id @default(cuid())
  teacherId      String
  subjectId      String
  gradeId        String
  sectionId      String
  academicYearId String

  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, gradeId, sectionId, academicYearId])
  @@index([teacherId])
  @@index([subjectId, gradeId, sectionId, academicYearId])
}

// ---------------------------------------------------------------------------
// Curriculum (national reference data, shared across all schools)
// ---------------------------------------------------------------------------

model CurriculumGrade {
  id   String @id @default(cuid())
  name String @unique // e.g. "Grade 5"

  subjects CurriculumSubject[]
}

model CurriculumSubject {
  id                String @id @default(cuid())
  curriculumGradeId String
  name              String // e.g. "Mathematics"

  curriculumGrade CurriculumGrade @relation(fields: [curriculumGradeId], references: [id], onDelete: Cascade)
  units           CurriculumUnit[]

  @@unique([curriculumGradeId, name])
}

model CurriculumUnit {
  id                  String @id @default(cuid())
  curriculumSubjectId String
  title               String // e.g. "Fractions"
  order               Int

  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  topics            CurriculumTopic[]
  learningOutcomes  LearningOutcome[]
  competencies      Competency[]
  academicPlans     AcademicPlan[]

  @@unique([curriculumSubjectId, order])
}

model CurriculumTopic {
  id               String @id @default(cuid())
  curriculumUnitId String
  title            String // e.g. "Introduction to fractions"
  order            Int

  curriculumUnit CurriculumUnit @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)
  planPeriods    PlanPeriod[]

  @@unique([curriculumUnitId, order])
}

model LearningOutcome {
  id               String @id @default(cuid())
  curriculumUnitId String
  description      String

  curriculumUnit CurriculumUnit @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)

  @@index([curriculumUnitId])
}

model Competency {
  id               String @id @default(cuid())
  curriculumUnitId String
  description      String

  curriculumUnit CurriculumUnit @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)

  @@index([curriculumUnitId])
}

// ---------------------------------------------------------------------------
// Academic planning / AI lesson plans
// ---------------------------------------------------------------------------

enum PlanPeriodStatus {
  PLANNED
  TAUGHT
  SKIPPED
}

model AcademicPlan {
  id               String   @id @default(cuid())
  schoolId         String
  academicYearId   String
  gradeId          String
  sectionId        String
  subjectId        String
  curriculumUnitId String
  teacherId        String
  createdAt        DateTime @default(now())

  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade          Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  curriculumUnit CurriculumUnit @relation(fields: [curriculumUnitId], references: [id], onDelete: Cascade)
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  periods PlanPeriod[]

  @@unique([sectionId, subjectId, curriculumUnitId, academicYearId])
  @@index([schoolId])
  @@index([teacherId])
}

model PlanPeriod {
  id               String            @id @default(cuid())
  academicPlanId   String
  periodNumber     Int
  curriculumTopicId String?
  customTopic      String?
  scheduledDate    DateTime?
  status           PlanPeriodStatus  @default(PLANNED)

  academicPlan    AcademicPlan     @relation(fields: [academicPlanId], references: [id], onDelete: Cascade)
  curriculumTopic CurriculumTopic? @relation(fields: [curriculumTopicId], references: [id])
  lessonPlan      LessonPlan?

  @@unique([academicPlanId, periodNumber])
}

model LessonPlan {
  id                    String   @id @default(cuid())
  planPeriodId          String   @unique
  objectives            Json
  activities            Json
  teachingMethods       Json
  materials             Json
  discussionQuestions   Json
  practiceActivities    Json
  homework              String?
  assessmentActivities  Json
  expectedEvidence      Json
  rubric                Json
  aiRawResponse         Json?
  editedByTeacher        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  planPeriod PlanPeriod @relation(fields: [planPeriodId], references: [id], onDelete: Cascade)
}
